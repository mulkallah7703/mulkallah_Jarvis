# Not required for the holographic UI preview.
# Required for chat / voice brain (server-side only — never NEXT_PUBLIC_*):
# GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
#
# Runtime reads GEMINI_API_KEY, then GOOGLE_GENERATIVE_AI_API_KEY.
# OPENAI_API_KEY is the fallback if Gemini fails or is unset.
